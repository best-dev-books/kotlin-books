<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="google-site-verification" content="bIGoozrasFhjwHR0CW__oi_irqCpf7wA8lmHA1jXRFs" />
	<title>{{ title }}</title>
	<meta name="description" content="{{ description or site.description }}">
	<link rel="canonical" href="{{ page.url | url | absoluteUrl(site.origin) }}">

	<meta property="og:type" content="{{ ogType or 'website' }}">
	<meta property="og:site_name" content="{{ site.name }}">
	<meta property="og:title" content="{{ title }}">
	<meta property="og:description" content="{{ description or site.description }}">
	<meta property="og:url" content="{{ page.url | url | absoluteUrl(site.origin) }}">
	<meta property="og:image" content="{{ (ogImage or '/assets/img/og-default.png') | url | absoluteUrl(site.origin) }}">

	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ title }}">
	<meta name="twitter:description" content="{{ description or site.description }}">
	<meta name="twitter:image" content="{{ (ogImage or '/assets/img/og-default.png') | url | absoluteUrl(site.origin) }}">

	<link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">

	{% if schema %}
	<script type="application/ld+json">{{ schema | dump | safe }}</script>
	{% endif %}
</head>
<body>
	<div class="page">
		<header class="site-header">
			<a class="site-title" href="{{ '/' | url }}">
				<span class="site-title-mark">K</span>Best Kotlin Books
			</a>
			<p class="site-tagline">Hand-picked Kotlin books for every skill level</p>
		</header>

		<main>
			{{ content | safe }}
		</main>

		<footer class="site-footer">
			<p>&copy; {{ "" | year }} Best Kotlin Books &middot; <a href="{{ '/' | url }}">Home</a></p>
			<p class="site-footer-note">Book covers &amp; titles are property of their respective publishers, shown here for editorial identification purposes.</p>
		</footer>
	</div>
</body>
</html>
