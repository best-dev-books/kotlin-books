---
layout: base.njk
pagination:
  data: books
  size: 1
  alias: book
permalink: "/books/{{ book.slug }}/"
eleventyComputed:
  title: "{{ book.title }} — Review & Summary | Best Kotlin Books"
  description: "{{ book.summary }}"
  ogImage: "{{ book.coverImage }}"
---

<nav class="breadcrumb"><a href="{{ '/' | url }}">&larr; Back to all books</a></nav>

<article class="book-detail">
	<img class="book-detail-cover" src="{{ book.coverImage | url }}" alt="{{ book.title }} book cover" width="300" height="450">

	<div>
		<h1>{{ book.title }}</h1>
		<p class="book-meta">By {{ book.authors | join(", ") }} &middot; {{ book.publisher }}, {{ book.year }}</p>

		<div class="book-detail-badges">
			<span class="badge badge-{{ book.level }}">{{ book.level }}</span>
			<ul class="tag-list">
				{% for tag in book.tags %}
				<li class="tag-pill">{{ tag }}</li>
				{% endfor %}
			</ul>
		</div>

		<p class="best-for"><strong>Best for:</strong> {{ book.bestFor }}</p>

		<p>{{ book.summary }}</p>

		<section>
			<h2>Why we recommend it</h2>
			<p>{{ book.whyRecommended }}</p>
		</section>

		<section>
			<h2>Where to buy</h2>
			<ul class="buy-links">
				{% for link in book.buyLinks %}
				<li><a href="{{ link.url }}" rel="nofollow noopener" target="_blank">{{ link.label }}</a></li>
				{% endfor %}
			</ul>
		</section>

		{% set related = book | relatedBooks(books) %}
		{% if related.length %}
		<section>
			<h2>Related books</h2>
			<ul class="related-books">
				{% for other in related %}
				<li><a href="{{ ('/books/' + other.slug + '/') | url }}">{{ other.title }}</a></li>
				{% endfor %}
			</ul>
		</section>
		{% endif %}
	</div>
</article>
